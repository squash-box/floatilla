# Copy to deploy/.env (git-ignored); docker compose reads it automatically.

# Claude Code on your Claude Pro/Max subscription. Generate with
# `claude setup-token` (valid for a year). When set, sandboxes run the
# Claude Code engine by default.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: floatilla's own agent loop on the Messages API (pay per token).
# Ignored by the Claude Code engine while CLAUDE_CODE_OAUTH_TOKEN is set.
ANTHROPIC_API_KEY=

# Optional overrides.
# FLOATILLA_MODEL_PROVIDER=claude-code   # claude-code | anthropic | scripted
# FLOATILLA_MODEL=claude-opus-5-5
# FLOATILLA_EFFORT=high
