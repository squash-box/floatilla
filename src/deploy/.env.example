# Copy to deploy/.env (git-ignored); docker compose reads it automatically.

# Claude Code on your Claude Pro/Max subscription. Generate with
# `claude setup-token` (valid for a year). When set, sandboxes run the
# Claude Code engine by default.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: floatilla's own agent loop on the Messages API (pay per token).
# Ignored by the Claude Code engine while CLAUDE_CODE_OAUTH_TOKEN is set.
ANTHROPIC_API_KEY=

# Optional overrides.
# FLOATILLA_MODEL_PROVIDER=claude-code   # claude-code | anthropic | scripted
# FLOATILLA_MODEL=claude-opus-5-5
# FLOATILLA_EFFORT=high

# Optional: story tracker. Approved plans publish their stories to Plane;
# items moved to "Ready for agent" become impl tasks. Create a personal access
# token under Plane → Profile settings → Personal access tokens.
# PLANE_API_KEY=
# PLANE_BASE_URL=https://api.plane.so     # or your self-hosted Plane
# PLANE_WORKSPACE=my-workspace            # the slug in app.plane.so/<slug>/
# PLANE_PROJECT=FLOAT                     # project identifier
# FLOATILLA_TRACKER_PUBLISH_TO=backlog    # backlog | ready (dispatch at once)
# FLOATILLA_TRACKER_REPO=https://github.com/you/app.git   # default inputs.repo
